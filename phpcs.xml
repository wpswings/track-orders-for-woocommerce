<?xml version="1.0"?>
<ruleset name="Track Orders for WooCommerce">
  <description>Security-focused coding standards for Track Orders plugin</description>

  <file>.</file>

  <!-- Exclude dependencies and bundled third-party libraries -->
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/package/lib/*</exclude-pattern>

  <!-- Output escaping, nonce checks and input sanitization -->
  <rule ref="WordPress.Security.EscapeOutput" />
  <rule ref="WordPress.Security.NonceVerification" />
  <rule ref="WordPress.Security.ValidatedSanitizedInput" />

  <!-- SQL injection -->
  <rule ref="WordPress.DB.PreparedSQL" />
  <rule ref="WordPress.DB.PreparedSQLPlaceholders" />

  <!-- Show progress -->
  <arg value="p"/>
  <arg name="colors"/>
  <arg name="extensions" value="php"/>
</ruleset>
