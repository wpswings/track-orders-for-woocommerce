{
  "name": "wpswings/track-orders-for-woocommerce",
  "description": "Track Orders for WooCommerce - Multi Carrier WooCommerce Shipping",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "WPSwings",
      "email": "support@wpswings.com",
      "homepage": "https://wpswings.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.0",
    "mockery/mockery": "^1.5"
  },
  "autoload": {
    "classmap": [
      "includes/",
      "admin/",
      "public/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
